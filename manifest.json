{
  "manifest_version": 3,
  "name": "__MSG_nombre__",
  "description": "__MSG_descripcion__",
  "version": "0.1.0",
  "default_locale": "es",
  "minimum_chrome_version": "126",
  "permissions": ["activeTab", "offscreen", "scripting", "storage", "unlimitedStorage"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "__MSG_nombre__"
  },
  "commands": {
    "alternar-grabacion": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "__MSG_atajoGrabacion__"
    },
    "alternar-pausa": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "__MSG_atajoPausa__"
    }
  }
}
